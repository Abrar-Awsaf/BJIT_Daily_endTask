<odoo>
    <data>
        <!-- Portal Entry for RFPs in Portal Menu -->
        <template id="portal_rfq_list" inherit_id="portal.portal_my_home">
            <xpath expr="//div[@id='portal_vendor_category']" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'" />
                    <t t-set="title">Submitted RFQ's</t>
                    <t t-set="text">View for Submit Quotations</t>
                    <t t-set="url" t-value="'/my/rfq'" />
                    <t t-set="config_card" t-value="True" />
                </t>
            </xpath>
        </template>

        <template id="rfq_list_template" name="My RFQs">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <h2 class="text-center text-primary">My Submitted RFQs</h2>

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>RFQ Number</th>
                                <th>RFP Reference</th>
                                <th>Status</th>
                                <th>Total Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="rfqs">
                                <t t-foreach="rfqs" t-as="rfq">
                                    <tr>
                                        <td>
                                            <t t-esc="rfq.name" />
                                        </td>
                                        <td>
                                            <t t-esc="rfq.rfp_id.rfp_number" />
                                        </td>
                                        <td>
                                            <t t-if="rfq.state == 'draft'">Pending</t>
                                            <t t-elif="rfq.state == 'approved'">Approved</t>
                                            <t t-elif="rfq.state == 'rejected'">Rejected</t>
                                        </td>
                                        <td><t t-esc="rfq.amount_total" /> USD</td>
                                        <td>
                                            <a t-att-href="'/my/rfq/view/' + str(rfq.id)"
                                                class="btn btn-sm btn-primary">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="5" class="text-center text-muted">
                                        No RFQs found.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>
    </data>
</odoo>