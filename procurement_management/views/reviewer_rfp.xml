<odoo>
    <data>

        <!-- RFP List View -->
        <record id="view_rfp_list" model="ir.ui.view">
            <field name="name">rfp.list</field>
            <field name="model">rfp.management</field>
            <field name="arch" type="xml">
                <tree string="Request for Purchase (RFP)">
                    <field name="rfp_number" />
                    <field name="status" />
                    <field name="expiry_date" />
                    <field name="total_amount" />
                </tree>
            </field>
        </record>

        <!-- RFP Form View -->
        <record id="view_rfp_form" model="ir.ui.view">
            <field name="name">rfp.form</field>
            <field name="model">rfp.management</field>
            <field name="arch" type="xml">
                <form string="Request for Purchase">
                    <header>
                        <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight"
                            modifiers="{'invisible': [('status', '!=', 'draft')]}" />

                        <button name="action_return_to_draft" string="Return to Draft" type="object"
                            class="oe_highlight"
                            modifiers="{'invisible': [('status', '!=', 'submitted')]}" />

                        <button name="action_recommend" string="Recommend" type="object"
                            class="oe_highlight"
                            modifiers="{'invisible': [('status', '!=', 'closed')]}" />

                        <field name="status" widget="statusbar" />
                    </header>
                    <sheet>
                        <group>
                            <field name="rfp_number" readonly="1" />
                            <field name="status" readonly="1" />
                            <field name="expiry_date" />
                            <field name="total_amount" readonly="1" />
                        </group>
                        <notebook>
                            <page string="Product Lines">
                                <field name="product_line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id" />
                                        <field name="product_image" widget="image" class="oe_avatar" />
                                        <field name="description" />
                                        <field name="quantity" />
                                        <field name="unit_price" />
                                        <field name="subtotal_price" />
                                        <field name="delivery_charges_supplier" />
                                    </tree>
                                </field>
                            </page>
                            <!-- <page string="RFQ Lines">
                                <field name="rfq_line_ids" />
                            </page> -->
                            <page string="RFQ Lines for Recommend to Approver">
                                <field name="rfq_line_ids">
                                    <tree editable="bottom">
                                        <field name="partner_id" string="Supplier"
                                            domain="[('company_id', '=', current_company_id)]" />
                                        <field name="company_id" invisible="1" />
                                        <field name="amount_total" string="Total Amount" />
                                        <field name="expected_delivery_date" />
                                        <field name="warranty_period" />
                                        <field name="score" />
                                        <field name="recommended" />
                                        <!-- widget="boolean_toggle"  -->
                                    </tree>
                                </field>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- RFP Action -->
        <record id="action_rfp_list" model="ir.actions.act_window">
            <field name="name">RFPs</field>
            <field name="res_model">rfp.management</field>
            <field name="view_mode">tree,form,graph,pivot</field>
            <field name="domain">[('create_uid', '=', uid)]</field>
            <field name="view_ids"
                eval="[
            (5, 0, 0), 
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_rfp_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_rfp_form')})
        ]" />
        </record>

        <!-- RFP Menu for Reviewers -->
        <!-- <menuitem id="menu_rfp_root" name="RFP Management" sequence="10" /> -->
        <menuitem id="menu_rfp" name="RFPs" parent="procurement_management.menu_rfp_root"
            action="action_rfp_list"
            groups="procurement_management.group_supplier_reviewer" sequence="10" />

    </data>
</odoo>