<odoo>
    <data>

        <!-- Approver RFP List View (Only Submitted RFPs) -->
        <record id="view_rfp_list_approver" model="ir.ui.view">
            <field name="name">rfp.list.approver</field>
            <field name="model">rfp.management</field>
            <field name="arch" type="xml">
                <tree string="Approver RFPs">
                    <field name="rfp_number" />
                    <field name="status" />
                    <field name="expiry_date" />
                    <field name="total_amount" />
                </tree>
            </field>
        </record>

        <!-- Approver RFP Form View -->
        <record id="view_rfp_form_approver" model="ir.ui.view">
            <field name="name">rfp.form.approver</field>
            <field name="model">rfp.management</field>
            <field name="arch" type="xml">
                <form string="Approver RFP View">
                    <header>
                        <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight"
                            modifiers="{'invisible': [('status', '!=', 'submitted')]}" />
                        <button name="action_reject" string="Reject" type="object"
                            class="oe_highlight"
                            modifiers="{'invisible': [('status', '!=', 'submitted')]}" />
                        <button name="action_close" string="Close" type="object"
                            class="oe_highlight"
                            modifiers="{'invisible': [('status', '!=', 'approved')]}" />
                        <button name="action_accept" string="Accept" type="object"
                            class="oe_highlight"
                            modifiers="{'invisible': [('status', '!=', 'recommendation')]}" />
                        <field name="status" widget="statusbar" />
                    </header>
                    <sheet>
                        <group>
                            <field name="rfp_number" readonly="1" />
                            <field name="status" readonly="1" />
                            <field name="expiry_date" readonly="1" />
                            <field name="total_amount" readonly="1" />
                        </group>
                        <notebook>
                            <page string="Product Lines">
                                <field name="product_line_ids" readonly="1" />
                            </page>
                            <page string="test RFQ Lines">
                                <group>
                                    <field name="selected_rfq_id" string="Select RFQ for PO" />
                                </group>
                                <field name="recommended_rfq_line_ids" />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ✅ Graph View for RFP Management -->
        <record id="view_rfp_graph" model="ir.ui.view">
            <field name="name">rfp.graph.view</field>
            <field name="model">rfp.management</field>
            <field name="arch" type="xml">
                <graph string="RFP Overview" type="bar">
                    <field name="expiry_date" type="row" interval="month" />
                    <field name="total_amount" type="measure" />
                    <field name="rfp_number" type="col" />
                    <field name="status" type="col" />
                </graph>
            </field>
        </record>

        <!-- ✅ Pivot View for RFP Management -->
        <record id="view_rfp_pivot" model="ir.ui.view">
            <field name="name">rfp.pivot.view</field>
            <field name="model">rfp.management</field>
            <field name="arch" type="xml">
                <pivot string="RFP Analysis">
                    <field name="approved_supplier_id" type="row" />
                    <field name="expiry_date" type="col" interval="month" />
                    <field name="status" type="row" />
                    <field name="total_amount" type="measure" />
                </pivot>
            </field>
        </record>

        <!-- Approver RFP Action (Moved to the Top) -->
        <record id="action_rfp_list_approver" model="ir.actions.act_window">
            <field name="name">Approver RFPs</field>
            <field name="res_model">rfp.management</field>
            <field name="view_mode">tree,form,graph,pivot</field>
            <field name="domain">[('status', '!=', 'draft')]</field>
            <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_rfp_list_approver')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_rfp_form_approver')}),
                (0,0,{'view_mode':'graph', 'view_id':ref('view_rfp_graph')}),
                (0,0,{'view_mode':'pivot', 'view_id':ref('view_rfp_pivot')})]" />
        </record>

        <!-- Approver RFP Menu -->
        <menuitem id="menu_rfp_root" name="RFP Management" sequence="10" />
        <menuitem id="menu_rfp_approver" name="Approver RFPs" parent="menu_rfp_root"
            action="action_rfp_list_approver"
            groups="procurement_management.group_supplier_approver" />

    </data>
</odoo>